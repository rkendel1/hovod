# Database
DATABASE_URL=mysql://root:root@mysql:3306/hovod
REDIS_URL=redis://redis:6379
PORT=3000

# S3 / MinIO
S3_ENDPOINT=http://minio:9000
S3_REGION=us-east-1
S3_BUCKET=hovod-vod
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_PUBLIC_BASE_URL=http://localhost:9000/hovod-vod

# Shared upload directory (API writes, Worker reads — must be same volume)
# UPLOAD_DIR=/data/uploads

# Dashboard & CORS
DASHBOARD_URL=http://localhost:3003
CORS_ORIGIN=http://localhost:3003,http://localhost:3002
VITE_API_BASE_URL=http://localhost:3002

# ─── Learn app (apps/learn) — consumer front door + owner back door ───
# Server-to-server API key the Next.js app uses to reach the Hovod API.
HOVOD_API_KEY=mk_live_replace_with_generated_api_key
# Base URL of the Hovod API from inside the Learn container (Fly: http://hovod.internal:3000)
# HOVOD_API_BASE_URL=http://api:3000
# NEXT_PUBLIC_OPENREELS_DEFAULT_PROVIDER=google
# NEXT_PUBLIC_OPENREELS_DEFAULT_TTS=elevenlabs
# NEXT_PUBLIC_OPENREELS_UI_URL=http://localhost:3100
# NEXT_PUBLIC_HOVOD_DASHBOARD_URL=http://localhost:3003

# Security — REQUIRED
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-generate-with-openssl-rand-hex-32

# ─── Registration & roles (optional — open by default) ─────────
# REGISTRATION_ENABLED=true                  # set to false to disable new signups
# REGISTRATION_ALLOWED_DOMAINS=example.com   # comma-separated list of allowed email domains
# OWNER_EMAILS=you@example.com               # comma-separated emails that get the platform-owner
#                                            # (back door) role on signup. Everyone else is a consumer.

# Docker Compose credentials (change these in production)
# MYSQL_ROOT_PASSWORD=change-me-in-production
# MINIO_ROOT_USER=change-me-in-production
# MINIO_ROOT_PASSWORD=change-me-in-production

# ─── Scaling (optional — auto-detected from hardware) ────
# WORKER_CONCURRENCY=2            # concurrent transcode jobs (default: auto from CPU/RAM)
# FFMPEG_THREADS=4                # threads per FFmpeg process (default: auto from CPU/concurrency)
# DB_POOL_SIZE=20                 # MySQL connection pool size (default: auto from RAM)

# ─── AI Processing (optional — omit to disable) ─────────
# Whisper-compatible transcription API (OpenAI, Groq, local, etc.)
# WHISPER_API_URL=https://api.openai.com/v1/audio/transcriptions
# WHISPER_API_KEY=sk-...
# WHISPER_MODEL=whisper-1

# LLM for chapter generation (openai | anthropic | groq | custom)
# LLM_PROVIDER=openai
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_API_URL=                  # custom endpoint (leave empty for default)
#
# Groq example:
# LLM_PROVIDER=groq
# LLM_API_KEY=gsk_...
# LLM_MODEL=llama-3.3-70b-versatile

# AI_ENABLED=true               # set to false to disable AI even if configured

# ─── Billing (optional — omit all for unlimited usage) ───
# Adding Stripe keys enables tiered billing, usage metering, and plan limits.
# Without Stripe, all features are available with no usage restrictions.
# STRIPE_SECRET_KEY=sk_test_...
# STRIPE_WEBHOOK_SECRET=whsec_...
# STRIPE_PRO_PRICE_ID=price_...
# STRIPE_BUSINESS_PRICE_ID=price_...

# ─── Webhooks (optional) ────────────────────────────────
# WEBHOOK_URL=https://your-app.com/webhook

# ─── OpenReels producer → distribution pipeline (optional) ──
# Owner approves a proposal → OpenReels generates a vertical MP4 → publisher
# ingests it into Hovod as a draft asset. All services read these same vars.
# OPENREELS_API_URL=http://openreels-api:3000
# OPENREELS_PUBLISHER_URL=http://openreels-hovod-publisher:3201
# OPENREELS_DEFAULT_PROVIDER=google
# OPENREELS_DEFAULT_TTS=elevenlabs
# PROPOSAL_REDIS_URL=redis://proposal-redis:6379

# ─── Proposal worker pipeline (optional) ───────────────────
# DISCOVERY_INTERVAL_HOURS=6
# MAX_CANDIDATES_PER_RUN=50
# MAX_PROPOSALS_PER_DAY=30
# MIN_QUALITY_SCORE=0.65
# AUTO_APPROVE_ABOVE=0
# YOUTUBE_FEEDS=MIT OCW|https://www.youtube.com/@mitocw
# PODCAST_FEEDS=Huberman Lab|https://feeds.megaphone.fm/hubermanlab

# ─── OpenReels generation providers (only if running OpenReels) ─────
# Consolidated here so a single .env drives every service. On Fly, import
# this file into BOTH apps: `fly secrets import -a <app> < .env`
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_API_KEY=
# ELEVENLABS_API_KEY=
# PEXELS_API_KEY=
# PIXABAY_API_KEY=
# FAL_API_KEY=
# MAX_JOBS=20
